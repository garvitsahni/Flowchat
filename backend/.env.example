# FloatChat backend .env template — copy to .env and fill in real values.
# Never commit the real .env.

# LLM provider: mock | gemini | openrouter | grok  (mock is the default until keys land)
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROK_API_KEY=

# DB (app role is read-only by default — do not flip to owner for /query)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=floatchat
DB_USER=floatchat_readonly
DB_PASSWORD=floatchat_dev

# Pipeline owner role
PIPELINE_DB_USER=floatchat_owner
PIPELINE_DB_PASSWORD=floatchat_dev