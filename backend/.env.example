# FloatChat backend .env template — copy to .env and fill in real values.
# Never commit the real .env.

# LLM provider: mock | gemini | openrouter | nvidia | groq  (mock is the default until keys land)
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=

# Optional per-provider model overrides
#GEMINI_MODEL=gemini-3.6-flash
#OPENROUTER_MODEL=openrouter/free
#NVIDIA_MODEL=meta/llama-3.1-8b-instruct
#GROQ_MODEL=openai/gpt-oss-120b

# DB (app role is read-only by default — do not flip to owner for /query)
# Local dev: port 55432 (Postgres 16/18 services own 5432 and 5433 on this machine).
# Deployed (Render/Railway/Supabase): point DB_* at the hosted Postgres+PostGIS.
# Supabase: use the pooler connection user (SELECT-only user, e.g. postgres.<ref>)
# and the pooler port (6543), NOT the direct 5432 — this keeps the app read-only.
DB_HOST=localhost
DB_PORT=55432
DB_NAME=floatchat
DB_USER=floatchat_readonly
DB_PASSWORD=floatchat_dev

# Pipeline owner role
PIPELINE_DB_USER=floatchat_owner
PIPELINE_DB_PASSWORD=floatchat_dev